{
  "name": "Ovile — WF1: Disparo Agendado (3x/dia)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "30 11 * * 1-6" },
            { "field": "cronExpression", "expression": "0 15 * * 1-6" },
            { "field": "cronExpression", "expression": "0 19 * * 1-6" }
          ]
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Agendamento 3x/dia (8:30, 12:00, 16:00 BRT)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "notes": "08:30 BRT = 11:30 UTC | 12:00 BRT = 15:00 UTC | 16:00 BRT = 19:00 UTC | Seg-Sab"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://ovile.com.br/api/n8n/leads?limit=20&cooldown_days=7&campaign_id=andre-santos-2026",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Buscar fila de leads (Ovile)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUBSTITUIR_ID_CREDENTIAL_OVILE",
          "name": "Ovile API — Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-count",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Há leads na fila?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Split — 1 lead por vez",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "amount": "={{ Math.floor(Math.random() * 3) + 2 }}",
        "unit": "minutes"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "Aguardar 2-4 min (anti-spam)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 200],
      "notes": "Delay aleatório 2-4 minutos entre mensagens para evitar banimento"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://ovile.com.br/api/n8n/config?campaign_id=andre-santos-2026",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000006",
      "name": "Buscar template de mensagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUBSTITUIR_ID_CREDENTIAL_OVILE",
          "name": "Ovile API — Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-lead-id",
              "name": "leadId",
              "value": "={{ $('Split — 1 lead por vez').item.json.id }}",
              "type": "string"
            },
            {
              "id": "set-lead-name",
              "name": "leadName",
              "value": "={{ $('Split — 1 lead por vez').item.json.name }}",
              "type": "string"
            },
            {
              "id": "set-lead-phone",
              "name": "leadPhone",
              "value": "={{ $('Split — 1 lead por vez').item.json.phone.replace(/\\D/g, '') }}",
              "type": "string"
            },
            {
              "id": "set-mensagem",
              "name": "mensagem",
              "value": "={{ $json.messages.invite.replace('{nome}', $('Split — 1 lead por vez').item.json.name) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000007",
      "name": "Montar dados do envio",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.z-api.io/instances/3F3DB93D8FCE11FDF2216E531F01401A/token/30BC72BA6F47BE762085BE77/send-text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Client-Token",
              "value": "Ffd62620c670443338f8d7bd0936987a8S"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"phone\": \"{{ $json.leadPhone.slice(-13) }}\",\n  \"message\": \"{{ $json.mensagem.replace(/\"/g, '\\\\\"') }}\"\n}",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000008",
      "name": "Enviar WhatsApp (Z-API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 200],
      "notes": "Z-API: phone = dígitos com código do país (ex: 5541987272587)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ovile.com.br/api/n8n/update-lead",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"collaboratorId\": \"{{ $('Montar dados do envio').item.json.leadId }}\",\n  \"action\": \"CONTACTED\",\n  \"campaignId\": \"andre-santos-2026\"\n}",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000009",
      "name": "Marcar CONTACTED no Ovile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUBSTITUIR_ID_CREDENTIAL_OVILE",
          "name": "Ovile API — Bearer Token"
        }
      }
    }
  ],
  "connections": {
    "Agendamento 3x/dia (8:30, 12:00, 16:00 BRT)": {
      "main": [
        [{ "node": "Buscar fila de leads (Ovile)", "type": "main", "index": 0 }]
      ]
    },
    "Buscar fila de leads (Ovile)": {
      "main": [
        [{ "node": "Há leads na fila?", "type": "main", "index": 0 }]
      ]
    },
    "Há leads na fila?": {
      "main": [
        [{ "node": "Split — 1 lead por vez", "type": "main", "index": 0 }],
        []
      ]
    },
    "Split — 1 lead por vez": {
      "main": [
        [{ "node": "Aguardar 2-4 min (anti-spam)", "type": "main", "index": 0 }]
      ]
    },
    "Aguardar 2-4 min (anti-spam)": {
      "main": [
        [{ "node": "Buscar template de mensagem", "type": "main", "index": 0 }]
      ]
    },
    "Buscar template de mensagem": {
      "main": [
        [{ "node": "Montar dados do envio", "type": "main", "index": 0 }]
      ]
    },
    "Montar dados do envio": {
      "main": [
        [{ "node": "Enviar WhatsApp (Z-API)", "type": "main", "index": 0 }]
      ]
    },
    "Enviar WhatsApp (Z-API)": {
      "main": [
        [{ "node": "Marcar CONTACTED no Ovile", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "staticData": null,
  "tags": ["ovile", "whatsapp", "leads", "agendado"],
  "__readme": {
    "workflow": "WF1 — Disparo Agendado (3x/dia) — Z-API",
    "descricao": "Executa às 08:30, 12:00 e 16:00 (horário de Brasília, seg-sab). Busca até 20 leads com status LEAD que não foram contactados nos últimos 7 dias. Para cada um: aguarda 2-4 min aleatórios (anti-banimento), busca o template, envia WhatsApp via Z-API e marca como CONTACTED.",
    "configurar": [
      "1. Verifique a credencial 'Ovile API — Bearer Token' nos nós HTTP do Ovile",
      "2. Ative o workflow (não precisa de URL — usa schedule)"
    ]
  }
}
