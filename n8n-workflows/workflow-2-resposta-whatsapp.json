{
  "name": "Ovile — WF2: Resposta WhatsApp (Detecta SIM/NÃO)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ovile-resposta-wa",
        "responseMode": "onReceived",
        "responseData": "firstEntryJson"
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000001",
      "name": "Webhook — Resposta Z-API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "ovile-resposta-wa",
      "notes": "Configure esta URL no painel Z-API em: Webhooks → On Message Received"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-type",
              "leftValue": "={{ $json.body.type }}",
              "rightValue": "ReceivedCallback",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "cond-fromme",
              "leftValue": "={{ String($json.body.fromMe) }}",
              "rightValue": "false",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000002",
      "name": "É mensagem recebida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "notes": "Filtra apenas mensagens recebidas (não enviadas pelo bot)"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-phone",
              "name": "fromPhone",
              "value": "={{ $json.body.phone.replace(/\\D/g, '').slice(-13) }}",
              "type": "string"
            },
            {
              "id": "set-msg",
              "name": "mensagemTexto",
              "value": "={{ ($json.body.text?.message ?? $json.body.text ?? '').toLowerCase().trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000003",
      "name": "Extrair telefone e texto",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://ovile.com.br/api/n8n/config?campaign_id=andre-santos-2026",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000011",
      "name": "Buscar config Ovile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUBSTITUIR_ID_CREDENTIAL_OVILE",
          "name": "Ovile API — Bearer Token"
        }
      },
      "notes": "Carrega templates + credenciais Z-API do tenant. Usado por ambos os ramos do switch."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "sim-cond",
                    "leftValue": "={{ $('Extrair telefone e texto').item.json.mensagemTexto }}",
                    "rightValue": "sim",
                    "operator": { "type": "string", "operation": "contains" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "SIM"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "nao-cond",
                    "leftValue": "={{ $('Extrair telefone e texto').item.json.mensagemTexto }}",
                    "rightValue": "não",
                    "operator": { "type": "string", "operation": "contains" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "NÃO"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "nao-sem-acento",
                    "leftValue": "={{ $('Extrair telefone e texto').item.json.mensagemTexto }}",
                    "rightValue": "nao",
                    "operator": { "type": "string", "operation": "contains" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "NÃO"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "OUTRO"
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000004",
      "name": "Detectar SIM / NÃO",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-welcome",
              "name": "mensagemBoasVindas",
              "value": "={{ $('Buscar config Ovile').item.json.messages.welcome?.replace('{nome}', 'amigo(a)') ?? 'Que ótimo! Bem-vindo(a)! ' + $('Buscar config Ovile').item.json.whatsappGroupLink }}",
              "type": "string"
            },
            {
              "id": "set-phone-sim",
              "name": "phoneParaEnviar",
              "value": "={{ $('Extrair telefone e texto').item.json.fromPhone }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000006",
      "name": "Montar boas-vindas",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1340, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Buscar config Ovile').item.json.zapi.sendTextUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Client-Token", "value": "={{ $('Buscar config Ovile').item.json.zapi.clientToken }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "={{ $json.phoneParaEnviar }}" },
            { "name": "message", "value": "={{ $json.mensagemBoasVindas }}" }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000007",
      "name": "Enviar boas-vindas + link grupo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ovile.com.br/api/n8n/update-lead",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "={{ $('Extrair telefone e texto').item.json.fromPhone }}" },
            { "name": "action", "value": "CONVERT" },
            { "name": "campaignId", "value": "andre-santos-2026" }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000008",
      "name": "CONVERT — Ovile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUBSTITUIR_ID_CREDENTIAL_OVILE",
          "name": "Ovile API — Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Buscar config Ovile').item.json.zapi.sendTextUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Client-Token", "value": "={{ $('Buscar config Ovile').item.json.zapi.clientToken }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "={{ $('Extrair telefone e texto').item.json.fromPhone }}" },
            { "name": "message", "value": "={{ $('Buscar config Ovile').item.json.messages.optOut?.replace('{nome}', 'amigo(a)') ?? 'Tudo bem! Sem problemas. Se mudar de ideia, estaremos por aqui. 🙏' }}" }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000009",
      "name": "Enviar despedida (NÃO)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ovile.com.br/api/n8n/update-lead",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "={{ $('Extrair telefone e texto').item.json.fromPhone }}" },
            { "name": "action", "value": "OPT_OUT" },
            { "name": "campaignId", "value": "andre-santos-2026" }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000010",
      "name": "OPT_OUT — Ovile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 320],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUBSTITUIR_ID_CREDENTIAL_OVILE",
          "name": "Ovile API — Bearer Token"
        }
      }
    }
  ],
  "connections": {
    "Webhook — Resposta Z-API": {
      "main": [
        [{ "node": "É mensagem recebida?", "type": "main", "index": 0 }]
      ]
    },
    "É mensagem recebida?": {
      "main": [
        [{ "node": "Extrair telefone e texto", "type": "main", "index": 0 }],
        []
      ]
    },
    "Extrair telefone e texto": {
      "main": [
        [{ "node": "Buscar config Ovile", "type": "main", "index": 0 }]
      ]
    },
    "Buscar config Ovile": {
      "main": [
        [{ "node": "Detectar SIM / NÃO", "type": "main", "index": 0 }]
      ]
    },
    "Detectar SIM / NÃO": {
      "SIM": [
        [{ "node": "Montar boas-vindas", "type": "main", "index": 0 }]
      ],
      "NÃO": [
        [{ "node": "Enviar despedida (NÃO)", "type": "main", "index": 0 }]
      ],
      "OUTRO": []
    },
    "Montar boas-vindas": {
      "main": [
        [{ "node": "Enviar boas-vindas + link grupo", "type": "main", "index": 0 }]
      ]
    },
    "Enviar boas-vindas + link grupo": {
      "main": [
        [{ "node": "CONVERT — Ovile", "type": "main", "index": 0 }]
      ]
    },
    "Enviar despedida (NÃO)": {
      "main": [
        [{ "node": "OPT_OUT — Ovile", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "staticData": null,
  "tags": ["ovile", "whatsapp", "resposta"],
  "__readme": {
    "workflow": "WF2 — Resposta WhatsApp — Z-API (multi-tenant via config)",
    "descricao": "Recebe webhook Z-API. Detecta SIM/NÃO. Credenciais Z-API e templates vêm de /api/n8n/config (por tenant).",
    "configurar": [
      "1. Copie a Production URL deste webhook",
      "2. No painel Z-API: Webhooks → On Message Received → cole a URL (via API PUT /update-webhook-received)",
      "3. Verifique a credencial 'Ovile API — Bearer Token'",
      "4. No Ovile → Configurações → Z-API: cadastre as credenciais da campanha",
      "5. Ative o workflow"
    ]
  }
}
