generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id              String   @id
  name            String
  logoBase64      String?  @db.Text
  joinCode        String?  @unique
  slug            String?  @unique
  dbUrl           String?  @db.Text
  plan            String   @default("free")
  active          Boolean  @default(true)
  // Personalização do candidato (Sprint 3)
  candidateName   String?
  candidatePhoto  String?  @db.Text
  office          String? // cargo pretendido (ex: "Deputado Estadual") — usado no recibo eleitoral
  party           String?
  district        String?
  electionYear    Int?
  primaryColor    String?
  secondaryColor  String?
  adminEmail      String?
  candidateNumber Int?     // número de urna (DivulgaCandContas)
  whatsappGroupLink String? @db.Text // grupo de apoiadores exibido na tela de sucesso do /cadastro
  materialWhatsappGroupLink String? @db.Text // grupo específico exibido na tela de sucesso do /material (pode diferir do grupo geral)
  youtubeVideoId  String?  // vídeo institucional exibido na tela de sucesso do /cadastro
  profileBadgeUrl String?  @db.Text // moldura PNG (com alpha) usada no /fotoperfil deste tenant
  // Chapa conjunta (ex: André Santos + Jeffrey Chiquini) — quando preenchido, o
  // /cadastro público mostra os dois candidatos, mas os leads continuam salvos
  // só no banco deste tenant (não duplica/mescla dados entre campanhas).
  partnerCandidateName   String?
  partnerCandidateNumber Int?
  partnerOffice          String?
  partnerBadgeUrl        String?  @db.Text // moldura do parceiro de chapa, usada no /fotoperfil ao selecioná-lo
  // Escopo de módulos visíveis no menu para esta campanha: "full" (padrão) ou "leads_only"
  // (esconde Dashboard/Zonas/Agenda/Financeiro/etc, deixando só Colaboradores + Relatório)
  moduleScope     String   @default("full")
  // Domínio customizado para resolver tenant em rotas públicas (/cadastro, /api/public/*)
  domain          String?  @unique
  // Integrações por tenant (Sprint 8 — multi-tenant real)
  metricoolToken  String?  @db.Text
  metricoolBlogId String?
  telegramBotToken String? @db.Text
  telegramChatId  String?
  zApiInstance    String?
  zApiToken       String?  @db.Text
  zApiClientToken String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  collaborators  Collaborator[]
  zones          Zone[]
  whatsappGroups WhatsAppGroup[]
  userCampaigns  UserCampaign[]
  churches       Church[]
  payingEntities PayingEntity[]
  suppliers      Supplier[]
  financialEntries FinancialEntry[]
  materialRequests MaterialRequest[]
  contracts      Contract[]
  bankTransactions BankTransaction[]
  bankAccountBalances BankAccountBalance[]
  tseComparativoSnapshots TseComparativoSnapshot[]
}

/// Fonte pagadora de cabos eleitorais — usada quando a campanha roda em chapa
/// conjunta com outros candidatos e cada um paga uma parte das duplas de entrega.
/// payingEntityId nulo em ChurchAssignment/PaymentReceipt = pagador padrão (o
/// próprio candidato da campanha, com CNPJ em Settings).
model PayingEntity {
  id             String   @id @default(cuid())
  campaignId     String   @default("andre-santos-2026")
  name           String // rótulo interno, ex: "Indiara Barbosa Custódio"
  candidateName  String?
  office         String?
  party          String?
  electionYear   Int?
  cnpj           String?
  razaoSocial    String?
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cep            String?
  municipio      String?
  uf             String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign    Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignments ChurchAssignment[]
  receipts    PaymentReceipt[]
  financialEntries FinancialEntry[]
  contracts   Contract[]

  @@index([campaignId])
}

/// Fornecedor cadastrado no módulo financeiro (restrito a isFinanceAdmin).
model Supplier {
  id          String   @id @default(cuid())
  campaignId  String   @default("andre-santos-2026")
  name        String
  document    String? // CNPJ ou CPF
  category    String?
  contactName String?
  phone       String?
  email       String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  municipio   String?
  uf          String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign  Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]
  contracts Contract[]

  @@index([campaignId])
}

enum FinancialEntryType {
  DESPESA
  RECEITA
}

enum FinancialEntryStatus {
  PAGO
  PENDENTE
  AGENDADO
}

enum PaymentMethod {
  PIX
  DINHEIRO
  TRANSFERENCIA
  BOLETO
  CARTAO
  OUTRO
}

/// Lançamento financeiro (despesa/receita) da campanha, restrito a isFinanceAdmin.
model FinancialEntry {
  id             String               @id @default(cuid())
  campaignId     String               @default("andre-santos-2026")
  type           FinancialEntryType
  amount         Float
  description    String
  category       String?
  date           DateTime
  paymentMethod  PaymentMethod?
  status         FinancialEntryStatus @default(PENDENTE)
  supplierId     String?
  payingEntityId String? // null = fonte padrão (candidato da própria campanha, CNPJ em Settings)
  contractId     String? // vincula o lançamento ao contrato que o originou (ex.: parcela de um contrato de prestação de serviços)
  receiptUrl     String?              @db.Text
  notes          String?
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  payingEntity PayingEntity? @relation(fields: [payingEntityId], references: [id], onDelete: SetNull)
  contract     Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id])
  bankTransaction BankTransaction?

  @@index([campaignId])
  @@index([supplierId])
  @@index([payingEntityId])
  @@index([contractId])
}

enum ContractTemplateType {
  PRESTACAO_SERVICOS_PJ
  PRESTACAO_SERVICOS_PF
  MILITANCIA
  TERMO_DOACAO
  TERMO_CESSAO
}

enum ContractStatus {
  GERADO
  ASSINADO
  CANCELADO
}

/// Contrato/termo eleitoral emitido pelo módulo financeiro (restrito a isFinanceAdmin).
/// O PDF é gerado a partir de um dos modelos padronizados da campanha (ver
/// src/lib/contracts.ts) — código sequencial por campanha (CT-001, CT-002...).
model Contract {
  id           String               @id @default(cuid())
  campaignId   String               @default("andre-santos-2026")
  code         String
  templateType ContractTemplateType
  status       ContractStatus       @default(GERADO)

  // Contraparte (Contratado/Doador/Cedente conforme templateType)
  counterpartyName      String
  counterpartyDocument  String // CNPJ ou CPF conforme templateType
  counterpartyAddress   String?
  counterpartyCity      String?
  counterpartyUf        String?
  counterpartyPhone     String?
  counterpartyEmail     String?
  representativeName    String? // sócio/representante — só templates PJ
  representativeCpf     String?
  representativeAddress String?

  objectDescription  String    @db.Text
  eventAddress       String? // local/horário de prestação — rótulo varia por templateType
  startDate          DateTime?
  endDate            DateTime?
  totalValue         Float?
  priceJustification String?   @db.Text
  paymentTerms       String?   @db.Text // texto livre — permite parcelamento (ex.: "entrada X + saldo Y")
  additionalClauses  String?   @db.Text // cláusula extra opcional (ex.: direitos de uso de material, política de revisões)
  signatureDate      DateTime  @default(now())
  forumCity          String?
  forumUf            String?

  supplierId     String?
  payingEntityId String?
  pdfUrl         String? @db.Text
  notes          String? @db.Text
  createdById    String

  // Rastreio de envio/assinatura — preenchidos automaticamente pelo fluxo de
  // envio (sentAt/sentChannel) e pelo upload manual do documento assinado
  // (signedPdfUrl/signedAt) que volta do Contratado(a).
  sentAt        DateTime?
  sentChannel   String? // "email" | "whatsapp"
  signedPdfUrl  String?   @db.Text
  signedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign         Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  supplier         Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  payingEntity     PayingEntity?    @relation(fields: [payingEntityId], references: [id], onDelete: SetNull)
  createdBy        User             @relation(fields: [createdById], references: [id])
  financialEntries FinancialEntry[]

  @@unique([campaignId, code])
  @@index([campaignId])
  @@index([supplierId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  campaignId    String    @default("andre-santos-2026")
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  collaborator  Collaborator?
  userCampaigns UserCampaign[]
  registeredCollaborators Collaborator[] @relation("RegisteredCollaborators")
  financialEntries FinancialEntry[]
  approvedMaterialRequests MaterialRequest[] @relation("ApprovedMaterialRequests")
  deliveredMaterialRequests MaterialRequest[] @relation("DeliveredMaterialRequests")
  contracts Contract[]
  @@index([campaignId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model UserCampaign {
  id           String       @id @default(cuid())
  userId       String?
  pendingEmail String?
  campaignId   String
  role         Role         @default(MEMBER)
  inviteStatus InviteStatus    @default(PENDING)
  tier         CollaboratorTier @default(APOIADOR)
  invitedBy      String?
  invitedAt      DateTime     @default(now())
  acceptedAt     DateTime?
  collaboratorId String? @unique
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collaborator Collaborator? @relation("InvitedAs", fields: [collaboratorId], references: [id], onDelete: SetNull)
  @@unique([userId, campaignId])
  @@index([pendingEmail])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([userId, read])
}

model ContactLog {
  id             String   @id @default(cuid())
  campaignId     String
  collaboratorId String
  kind           String   // SENT_INVITE, SENT_REACTIVATION, RECEIVED_YES, RECEIVED_NO, CONVERT, OPT_OUT, MANUAL_NOTE
  channel        String?  // WHATSAPP, EMAIL, MANUAL
  actorId        String?  // userId que disparou (se manual)
  source         String?  // WF1, WF3, WF4, MANUAL_FORM, MANUAL_ADMIN
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  @@index([collaboratorId, createdAt])
  @@index([campaignId, createdAt])
  @@index([campaignId, kind])
}

// Mensagens de WhatsApp recebidas/enviadas, capturadas pelo webhook da Z-API (F3).
// Inbox é construído do "agora pra frente" — Z-API multi-device não dá histórico.
model WhatsappMessage {
  id              String   @id @default(cuid())
  campaignId      String
  phone           String   // telefone do contato (DDI+DDD+número, sem sufixo de grupo)
  phoneNormalized String?  // últimos 8 dígitos — agrupa a conversa / casa com Collaborator
  fromMe          Boolean  @default(false)
  senderName      String?
  type            String   @default("text") // text|image|audio|video|document|other
  body            String?  @db.Text         // texto ou legenda da mídia
  mediaUrl        String?  @db.Text
  zapiMessageId   String?  @unique          // dedup de reentrega do webhook
  isGroup         Boolean  @default(false)
  read            Boolean  @default(false)
  timestamp       DateTime @default(now())  // horário real da mensagem (Z-API momment)
  createdAt       DateTime @default(now())
  @@index([campaignId, phoneNormalized, timestamp])
  @@index([campaignId, read])
}

model Collaborator {
  id           String             @id @default(cuid())
  campaignId   String
  name         String
  email        String?
  phone        String?
  phoneNormalized String?   // últimos 8 dígitos de phone — dedup indexável (Sprint 25)
  cpf          String?   // apenas dígitos — necessário pro recibo eleitoral (prestação de contas)
  city         String?
  neighborhood String?
  campaignRole CollaboratorRole   @default(VOLUNTARIO)
  status       CollaboratorStatus @default(ACTIVE)
  notes        String?
  photoUrl     String?
  birthday     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  source             String?
  channel            CollaboratorChannel?
  profile            CollaboratorProfile @default(APOIADOR)
  supportStatus      SupportStatus       @default(NEUTRO)
  contributionTypes  String[]
  registeredById     String?
  lgpdConsent        Boolean   @default(false)
  lgpdConsentAt      DateTime?
  lastContactedAt    DateTime?
  userId String? @unique
  inviteRecord UserCampaign? @relation("InvitedAs")
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  registeredBy User?     @relation("RegisteredCollaborators", fields: [registeredById], references: [id], onDelete: SetNull)
  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  zones          ZoneCollaborator[]
  whatsappGroups WhatsAppGroupMember[]
  attendances    Attendance[]
  rsvps          EventRsvp[]
  assignmentsAsMember1 ChurchAssignment[] @relation("AssignmentMember1")
  assignmentsAsMember2 ChurchAssignment[] @relation("AssignmentMember2")
  pastorOfChurches Church[] @relation("ChurchPastor")
  contactLogs    ContactLog[]
  paymentReceipts PaymentReceipt[]
  materialRequests MaterialRequest[]
  @@index([campaignId])
  @@index([email])
  @@index([city])
  @@index([registeredById])
  @@index([status])
  @@index([supportStatus])
  @@index([campaignId, status])
  @@index([campaignId, createdAt])
  // Sprint 24 — índices p/ queries quentes (ranking, my-cell, dashboard, fila n8n, stats)
  @@index([campaignId, registeredById, status])
  @@index([campaignId, lastContactedAt])
  @@index([campaignId, supportStatus])
  @@index([campaignId, phoneNormalized])
}

model Zone {
  id         String   @id @default(cuid())
  campaignId String
  name       String
  type       ZoneType @default(MUNICIPAL)
  parentId   String?
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parent         Zone?              @relation("ZoneHierarchy", fields: [parentId], references: [id])
  children       Zone[]             @relation("ZoneHierarchy")
  collaborators  ZoneCollaborator[]
  whatsappGroups WhatsAppGroup[]
  events         Event[]
  @@index([campaignId])
  @@index([parentId])
}

model ZoneCollaborator {
  id             String   @id @default(cuid())
  zoneId         String
  collaboratorId String
  isLeader       Boolean  @default(false)
  joinedAt       DateTime @default(now())
  zone         Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  @@unique([zoneId, collaboratorId])
  @@index([collaboratorId])
}

model WhatsAppGroup {
  id          String   @id @default(cuid())
  campaignId  String
  zoneId      String?
  name        String
  inviteLink  String?
  description String?
  // Roteamento regional do welcome WhatsApp (WF2): lead com city em
  // região X recebe link do grupo dessa região. Se null e isFallback=false,
  // grupo não participa do roteamento automático.
  region      PRRegion?
  // Grupo geral — recebe leads cuja região não bate em nenhum específico
  // (incluindo city=NULL). Apenas 1 grupo por campanha deveria ser fallback.
  isFallback  Boolean   @default(false)
  // ID do grupo real na Z-API (ex: "120363019502650977-group") — vincula o
  // registro ao grupo do WhatsApp da campanha p/ administração via painel
  zapiGroupId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaign Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  zone     Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  members  WhatsAppGroupMember[]
  @@index([campaignId])
  @@index([zoneId])
  @@index([region])
}

enum PRRegion {
  RMC
  LITORAL
  NORTE
  NOROESTE
  OESTE
  SUDOESTE
  SUL
  CENTRO
  OUTROS
}

model WhatsAppGroupMember {
  id             String   @id @default(cuid())
  groupId        String
  collaboratorId String
  addedAt        DateTime @default(now())
  group        WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  collaborator Collaborator  @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  @@unique([groupId, collaboratorId])
  @@index([collaboratorId])
}

model Event {
  id                    String            @id @default(cuid())
  campaignId            String            @default("andre-santos-2026")
  zoneId                String?
  title                 String
  type                  CampaignEventType @default(REUNIAO)
  date                  DateTime
  location              String?
  notes                 String?
  googleCalendarEventId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  zone        Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  attendances Attendance[]
  rsvps       EventRsvp[]
  @@index([campaignId])
  @@index([zoneId])
  @@index([date])
}

model Attendance {
  id             String           @id @default(cuid())
  eventId        String
  collaboratorId String?
  status         AttendanceStatus @default(ABSENT)
  justification  String?
  createdAt      DateTime         @default(now())
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  collaborator Collaborator? @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  @@index([eventId])
  @@index([collaboratorId])
}

model EventRsvp {
  id             String   @id @default(cuid())
  eventId        String
  collaboratorId String
  createdAt      DateTime @default(now())
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  @@unique([eventId, collaboratorId])
}

model Broadcast {
  id         String   @id @default(cuid())
  campaignId String   @default("andre-santos-2026")
  title      String
  message    String   @db.Text
  audience   String                                  // Label legível: "Gospel Class", "Apoiadores PSL", etc
  type       BroadcastType   @default(DIRECT)        // DIRECT/GROUP/BROADCAST
  status     BroadcastStatus @default(DRAFT)         // DRAFT/QUEUED/SENDING/PAUSED/COMPLETED/FAILED/CANCELLED
  filters    Json?                                   // { source: "GOSPEL_CLASS", status: "LEAD", city: "Curitiba", ... }
  groupId    String?                                 // Z-API groupId quando type=GROUP
  attachmentUrl   String?  @db.Text                  // Vercel Blob URL de imagem/PDF (opcional)
  attachmentType  String?                            // "image" | "document"
  delaySecondsMin Int       @default(300)            // 5min default (anti-ban)
  delaySecondsMax Int       @default(600)            // 10min default
  dailyLimit      Int       @default(200)            // Máx mensagens iniciadas por dia
  varyMessage     Boolean   @default(true)           // Varia saudação/fechamento por destinatário (anti-ban, sem IA)
  totalCount      Int       @default(0)              // Total agendadas
  sentCount       Int       @default(0)              // Já enviadas
  failedCount     Int       @default(0)              // Falharam (Z-API erro, phone inválido)
  scheduledFor    DateTime?                          // Disparo agendado opcional
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?   @db.Text                 // Mensagem de erro quando FAILED
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  deliveries BroadcastDelivery[]
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

model BroadcastDelivery {
  id             String     @id @default(cuid())
  broadcastId    String
  broadcast      Broadcast  @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  collaboratorId String?                                  // Pode ser null se for número avulso
  phone          String                                   // Phone normalizado (só dígitos)
  name           String?                                  // Snapshot do nome no momento do envio
  status         DeliveryStatus  @default(PENDING)        // PENDING/SENDING/SENT/DELIVERED/READ/FAILED/SKIPPED
  zapiMessageId  String?                                  // ID retornado pelo Z-API send-text
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  error          String?    @db.Text
  attemptCount   Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt
  @@index([broadcastId])
  @@index([status])
  @@index([phone])
}

enum BroadcastType {
  DIRECT      // 1:1 — manda mensagem individual pra cada destinatário (com pacing)
  GROUP       // Posta única vez num grupo WhatsApp existente
  BROADCAST   // Lista de transmissão Z-API (até 256, recipientes não veem outros)
}

enum BroadcastStatus {
  DRAFT       // Criado mas ainda não disparado
  QUEUED      // Pronto pro n8n consumir
  SENDING     // n8n está processando
  PAUSED      // Admin pausou no meio
  COMPLETED   // Todos os destinatários processados
  FAILED      // Erro fatal antes de completar
  CANCELLED   // Admin cancelou
}

enum DeliveryStatus {
  PENDING     // Aguardando envio
  SENDING     // Reservada por uma chamada a /api/n8n/broadcast/next, aguardando confirmação
  SENT        // Enviado via Z-API, aguardando ACK
  DELIVERED   // Z-API confirmou entrega
  READ        // Destinatário leu
  FAILED      // Erro no envio (Z-API/phone inválido)
  SKIPPED     // Pulado (ex: phone duplicado dentro do batch)
}

model InviteLink {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  campaignId String    @default("andre-santos-2026")
  role       Role      @default(MEMBER)
  createdBy  String
  expiresAt  DateTime?
  useCount   Int       @default(0)
  usedAt     DateTime?
  usedBy     String?
  createdAt  DateTime  @default(now())
  @@index([campaignId])
}

model Settings {
  id                   String   @id @default("singleton")
  campaignName         String   @default("Base Andre Santos")
  logoBase64           String?  @db.Text
  googleRefreshToken   String?  @db.Text
  whatsappGroupLink    String?  // Link de convite do grupo WhatsApp de apoiadores
  deliveryPaymentValue Float    @default(10) // R$ por entrega confirmada (ChurchAssignment ENTREGUE), por membro da dupla
  // Dados cadastrais do CNPJ da campanha
  cnpj                 String?
  razaoSocial          String?
  cnpjLogradouro       String?
  cnpjNumero           String?
  cnpjComplemento      String?
  cnpjBairro           String?
  cnpjCep              String?
  cnpjMunicipio        String?
  cnpjUf               String?
  updatedAt            DateTime @updatedAt
}

