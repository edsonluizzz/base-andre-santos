// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth) ───────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  member        Member?
}

// ─── Notificações ─────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Membros do grupo ─────────────────────────────────────────────────────

model Member {
  id        String       @id @default(cuid())
  name      String
  birthday  String?
  phone     String?
  photoUrl  String?
  status    MemberStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  attendances Attendance[]
  offerings   Offering[]
  shirtOrders ShirtOrder[]
}

// ─── Eventos ──────────────────────────────────────────────────────────────

model Event {
  id        String    @id @default(cuid())
  title     String
  type      EventType
  date      DateTime
  location  String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  attendances Attendance[]
  offerings   Offering[]
}

// ─── Chamada ──────────────────────────────────────────────────────────────

model Attendance {
  id        String           @id @default(cuid())
  eventId   String
  memberId  String
  status    AttendanceStatus @default(ABSENT)
  createdAt DateTime         @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

// ─── Financeiro ───────────────────────────────────────────────────────────

model Offering {
  id        String        @id @default(cuid())
  memberId  String
  eventId   String?
  amount    Float
  method    PaymentMethod @default(CASH)
  notes     String?
  date      DateTime      @default(now())
  createdAt DateTime      @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

// ─── Despesas ─────────────────────────────────────────────────────────────

model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Float
  category    ExpenseCategory @default(OUTRO)
  date        DateTime        @default(now())
  notes       String?
  createdAt   DateTime        @default(now())
}

// ─── Configurações globais ────────────────────────────────────────────────

model Settings {
  id         String   @id @default("singleton")
  churchName String   @default("Porto Belo")
  logoBase64 String?  @db.Text
  updatedAt  DateTime @updatedAt
}

// ─── Permissões por Role ───────────────────────────────────────────────────

model RolePermission {
  id        String           @id @default(cuid())
  role      Role
  module    PermissionModule
  action    PermissionAction
  granted   Boolean          @default(false)
  updatedAt DateTime         @updatedAt
  updatedBy String?

  @@unique([role, module, action])
}

// ─── Congressos e Camisetas ───────────────────────────────────────────────

model Congress {
  id            String         @id @default(cuid())
  name          String
  date          DateTime
  location      String?
  description   String?
  status        CongressStatus @default(OPEN)
  shirtArtUrl   String?
  shirtPricing  Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  shirtOrders ShirtOrder[]
}

model ShirtOrder {
  id                     String           @id @default(cuid())
  congressId             String
  memberId               String
  size                   ShirtSize
  quantity               Int              @default(1)
  color                  String?
  paidAmount             Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount            Decimal          @db.Decimal(10, 2)
  paymentMethod          PaymentMethod?
  paymentDate            DateTime?
  status                 ShirtOrderStatus @default(PENDING)
  deliveredAt            DateTime?
  notes                  String?
  paymentProofUrl        String?
  paymentProofUploadedAt DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  createdBy              String?

  congress Congress @relation(fields: [congressId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([congressId, memberId])
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  LEADER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum EventType {
  CULTO
  ENSAIO
  REUNIAO
  RETIRO
  OUTRO
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

enum PaymentMethod {
  CASH
  PIX
}

enum ExpenseCategory {
  MATERIAL
  TRANSPORTE
  ALIMENTACAO
  EVENTO
  OUTRO
}

enum PermissionModule {
  MEMBERS
  ATTENDANCE
  FINANCIAL
  REPORTS
  EVENTS
  BIRTHDAYS
  SHIRTS
  SETTINGS
  USERS
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  EXPORT
}

enum ShirtSize {
  PP
  P
  M
  G
  GG
  XG
  XXG
}

enum ShirtOrderStatus {
  PENDING
  PAID
  PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

enum CongressStatus {
  OPEN
  CLOSED
  FINISHED
}
