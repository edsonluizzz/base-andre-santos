generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id         String   @id
  name       String
  logoBase64 String?  @db.Text
  joinCode   String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  collaborators  Collaborator[]
  zones          Zone[]
  whatsappGroups WhatsAppGroup[]
  userCampaigns  UserCampaign[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  campaignId    String    @default("andre-santos-2026")
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  collaborator  Collaborator?
  userCampaigns UserCampaign[]
  registeredCollaborators Collaborator[] @relation("RegisteredCollaborators")
  @@index([campaignId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model UserCampaign {
  id           String       @id @default(cuid())
  userId       String?
  pendingEmail String?
  campaignId   String
  role         Role         @default(MEMBER)
  inviteStatus InviteStatus    @default(PENDING)
  tier         CollaboratorTier @default(APOIADOR)
  invitedBy      String?
  invitedAt      DateTime     @default(now())
  acceptedAt     DateTime?
  collaboratorId String? @unique
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collaborator Collaborator? @relation("InvitedAs", fields: [collaboratorId], references: [id], onDelete: SetNull)
  @@unique([userId, campaignId])
  @@index([pendingEmail])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Collaborator {
  id           String             @id @default(cuid())
  campaignId   String
  name         String
  email        String?
  phone        String?
  city         String?
  neighborhood String?
  campaignRole CollaboratorRole   @default(VOLUNTARIO)
  status       CollaboratorStatus @default(ACTIVE)
  notes        String?
  photoUrl     String?
  birthday     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  source        String?
  profile       CollaboratorProfile @default(APOIADOR)
  supportStatus SupportStatus       @default(NEUTRO)
  contributionTypes String[]
  registeredById    String?
  lgpdConsent       Boolean   @default(false)
  lgpdConsentAt     DateTime?
  userId String? @unique
  inviteRecord UserCampaign? @relation("InvitedAs")
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  registeredBy User?     @relation("RegisteredCollaborators", fields: [registeredById], references: [id], onDelete: SetNull)
  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  zones          ZoneCollaborator[]
  whatsappGroups WhatsAppGroupMember[]
  attendances    Attendance[]
  rsvps          EventRsvp[]
  @@index([campaignId])
  @@index([email])
  @@index([city])
  @@index([registeredById])
  @@index([status])
  @@index([supportStatus])
}

model Zone {
  id         String   @id @default(cuid())
  campaignId String
  name       String
  type       ZoneType @default(MUNICIPAL)
  parentId   String?
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parent         Zone?              @relation("ZoneHierarchy", fields: [parentId], references: [id])
  children       Zone[]             @relation("ZoneHierarchy")
  collaborators  ZoneCollaborator[]
  whatsappGroups WhatsAppGroup[]
  events         Event[]
  @@index([campaignId])
  @@index([parentId])
}

model ZoneCollaborator {
  id             String   @id @default(cuid())
  zoneId         String
  collaboratorId String
  isLeader       Boolean  @default(false)
  joinedAt       DateTime @default(now())
  zone         Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  @@unique([zoneId, collaboratorId])
  @@index([collaboratorId])
}

model WhatsAppGroup {
  id          String   @id @default(cuid())
  campaignId  String
  zoneId      String?
  name        String
  inviteLink  String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaign Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  zone     Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  members  WhatsAppGroupMember[]
  @@index([campaignId])
  @@index([zoneId])
}

model WhatsAppGroupMember {
  id             String   @id @default(cuid())
  groupId        String
  collaboratorId String
  addedAt        DateTime @default(now())
  group        WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  collaborator Collaborator  @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  @@unique([groupId, collaboratorId])
  @@index([collaboratorId])
}

model Event {
  id                    String            @id @default(cuid())
  campaignId            String            @default("andre-santos-2026")
  zoneId                String?
  title                 String
  type                  CampaignEventType @default(REUNIAO)
  date                  DateTime
  location              String?
  notes                 String?
  googleCalendarEventId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  zone        Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  attendances Attendance[]
  rsvps       EventRsvp[]
  @@index([campaignId])
  @@index([zoneId])
  @@index([date])
}

model Attendance {
  id             String           @id @default(cuid())
  eventId        String
  collaboratorId String?
  status         AttendanceStatus @default(ABSENT)
  justification  String?
  createdAt      DateTime         @default(now())
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  collaborator Collaborator? @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  @@index([eventId])
  @@index([collaboratorId])
}

model EventRsvp {
  id             String   @id @default(cuid())
  eventId        String
  collaboratorId String
  createdAt      DateTime @default(now())
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  @@unique([eventId, collaboratorId])
}

model Broadcast {
  id         String   @id @default(cuid())
  campaignId String   @default("andre-santos-2026")
  title      String
  message    String   @db.Text
  audience   String
  sentCount  Int      @default(0)
  createdBy  String?
  createdAt  DateTime @default(now())
  @@index([campaignId])
}

model InviteLink {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  campaignId String    @default("andre-santos-2026")
  role       Role      @default(MEMBER)
  createdBy  String
  expiresAt  DateTime?
  useCount   Int       @default(0)
  usedAt     DateTime?
  usedBy     String?
  createdAt  DateTime  @default(now())
  @@index([campaignId])
}

model Settings {
  id                  String   @id @default("singleton")
  campaignName        String   @default("Base Andre Santos")
  logoBase64          String?  @db.Text
  googleRefreshToken  String?  @db.Text
  updatedAt           DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([actorId])
  @@index([createdAt])
}

enum Role {
  ADMIN
  LEADER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

enum CollaboratorRole {
  COORD_GERAL
  COORD_REGIONAL
  LIDER_MUNICIPAL
  LIDER_BAIRRO
  VOLUNTARIO
}

enum CollaboratorStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum ZoneType {
  REGIONAL
  MUNICIPAL
  BAIRRO
}

enum CampaignEventType {
  REUNIAO
  COMICIO
  PANFLETAGEM
  TREINAMENTO
  VISITA
  OUTRO
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

enum CollaboratorProfile {
  PASTOR
  PRESIDENTE_ASSOCIACAO
  LIDER_POLITICO
  VEREADOR
  EMPRESARIO
  LIDERANCA_COMUNITARIA
  APOIADOR
}

enum SupportStatus {
  CONFIRMADO
  NEGOCIANDO
  NEUTRO
  ADVERSARIO
}

enum CollaboratorTier {
  APOIADOR
  ATIVISTA
  LIDER_CELULA
  COORDENADOR
}
