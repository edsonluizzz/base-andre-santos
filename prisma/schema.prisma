model Church {
  id          String   @id @default(cuid())
  campaignId  String   @default("andre-santos-2026")
  name        String
  regional    String?
  denominacao String?
  pastorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pastor      Collaborator?      @relation("ChurchPastor", fields: [pastorId], references: [id], onDelete: SetNull)
  assignments ChurchAssignment[]

  @@index([campaignId])
  @@index([regional])
  @@index([denominacao])
  @@index([pastorId])
}

model ChurchAssignment {
  id            String                 @id @default(cuid())
  churchId      String
  status        ChurchAssignmentStatus @default(PENDENTE)
  photoUrl      String?                @db.Text
  notes         String?
  assignedById  String
  member1Id     String
  member2Id     String? // dupla é o ideal, mas uma pessoa sozinha não pode travar o salvamento
  deliveredAt   DateTime?
  member1PaidAt DateTime? // null = pendente de pagamento; preenchido = pago (timestamp = auditoria)
  member2PaidAt DateTime?
  payingEntityId String? // null = fonte padrão (candidato da própria campanha, CNPJ em Settings)
  paymentValue  Float? // valor por membro nesta entrega — null = usa Settings.deliveryPaymentValue (padrão global)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  church       Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member1      Collaborator  @relation("AssignmentMember1", fields: [member1Id], references: [id], onDelete: Cascade)
  member2      Collaborator? @relation("AssignmentMember2", fields: [member2Id], references: [id], onDelete: Cascade)
  payingEntity PayingEntity? @relation(fields: [payingEntityId], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@index([status])
  @@index([member1Id])
  @@index([member2Id])
  @@index([payingEntityId])
}

enum ChurchAssignmentStatus {
  PENDENTE
  ENTREGUE
  NAO_FOI_POSSIVEL
}

model PaymentReceipt {
  id             String   @id @default(cuid())
  collaboratorId String
  amount         Float // total pago neste recibo (rate × count, snapshot)
  rate           Float // valor unitário aplicado no momento (auditoria)
  assignmentIds  String[]
  payingEntityId String? // null = fonte padrão (candidato da própria campanha)
  paymentMethod  PaymentMethod? // forma de pagamento — exigido pra prestação de contas TSE
  pdfUrl         String?              @db.Text
  emailStatus    ReceiptChannelStatus @default(SKIPPED)
  whatsappStatus ReceiptChannelStatus @default(SKIPPED)
  emailError     String?              @db.Text
  whatsappError  String?              @db.Text
  createdAt      DateTime             @default(now())

  collaborator Collaborator  @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  payingEntity PayingEntity? @relation(fields: [payingEntityId], references: [id], onDelete: SetNull)

  @@index([collaboratorId])
  @@index([payingEntityId])
}

enum ReceiptChannelStatus {
  SKIPPED
  SENT
  FAILED
}

enum MaterialRequestStatus {
  PENDENTE_APROVACAO
  APROVADO
  ENTREGUE
  RECUSADO
}

/// Solicitação de material de campanha + Termo de Apoiador (aceite clickwrap).
/// O termo já sai assinado (PDF) na criação — o que fica pendente de aprovação
/// é a ENTREGA física do material, não a assinatura. termSnapshot* preserva o
/// que foi de fato aceito mesmo se o Collaborator for editado depois.
model MaterialRequest {
  id               String                @id @default(cuid())
  campaignId       String
  collaboratorId   String
  items            Json                  // [{ item: "Santinho", qty: 200 }, ...]
  status           MaterialRequestStatus @default(PENDENTE_APROVACAO)

  termSnapshotName String
  termSnapshotCpf  String
  termVersion      String                // versão do texto legal aceito (auditoria)
  termAcceptedAt   DateTime
  termIp           String?
  termUserAgent    String?               @db.Text

  // Endereço completo de entrega — snapshot no momento do pedido (a pessoa
  // pode se mudar depois; a entrega física precisa do endereço de então).
  deliveryCep          String?
  deliveryLogradouro   String?
  deliveryNumero       String?
  deliveryComplemento  String?
  deliveryBairro       String?
  deliveryMunicipio    String?
  deliveryUf           String?

  pdfUrl           String?               @db.Text
  emailStatus      ReceiptChannelStatus  @default(SKIPPED)
  whatsappStatus   ReceiptChannelStatus  @default(SKIPPED)
  emailError       String?               @db.Text
  whatsappError    String?               @db.Text

  approvedById     String?
  approvedAt       DateTime?
  deliveredById    String?
  deliveredAt      DateTime?
  notes            String?               @db.Text

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("ApprovedMaterialRequests", fields: [approvedById], references: [id], onDelete: SetNull)
  deliveredBy  User?        @relation("DeliveredMaterialRequests", fields: [deliveredById], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([collaboratorId])
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

/// Transação de extrato bancário (OFX) importada — conciliação com FinancialEntry.
/// A constraint única (campaignId, acctId, fitid) deduplica reimportações de um
/// mesmo extrato com datas sobrepostas.
model BankTransaction {
  id             String                @id @default(cuid())
  campaignId     String                @default("andre-santos-2026")
  bankId         String
  branchId       String
  acctId         String
  fitid          String
  trnType        String // CREDIT | DEBIT
  amount         Float // valor com sinal, como veio do OFX
  postedAt       DateTime
  name           String
  memo           String?               @db.Text
  status         BankTransactionStatus @default(UNMATCHED)
  matchedEntryId String?               @unique
  importedAt     DateTime              @default(now())

  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  matchedEntry FinancialEntry? @relation(fields: [matchedEntryId], references: [id], onDelete: SetNull)

  @@unique([campaignId, acctId, fitid])
  @@index([campaignId])
  @@index([status])
}

/// Saldo real da conta, direto do <LEDGERBAL> do OFX (não uma soma derivada das
/// transações importadas — o banco informa esse valor, é mais confiável do que
/// recalcular localmente). Atualizado (upsert) a cada nova importação de extrato.
model BankAccountBalance {
  id         String   @id @default(cuid())
  campaignId String   @default("andre-santos-2026")
  bankId     String
  branchId   String
  acctId     String
  balance    Float
  asOf       DateTime
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, acctId])
  @@index([campaignId])
}

/// Snapshot salvo do comparativo de receitas do DivulgaCandContas (TSE) — a API
/// pública deles bloqueia chamadas de servidor/datacenter (Vercel incluído), então
/// não dá pra consultar ao vivo. Em vez disso, alguém busca os dados navegando de
/// verdade no site da TSE (ex.: Claude via browser automation) e grava aqui; a tela
/// só lê o último snapshot salvo, mostrando a data da consulta.
model TseComparativoSnapshot {
  id         String   @id @default(cuid())
  campaignId String   @default("andre-santos-2026")
  uf         String
  cargo      Int
  partido    Int
  data       Json // array de { numero, nome, situacao, totalRecebido, qtdRecebido, totalReceitaPF, totalReceitaPJ, totalPartidos, dataUltimaAtualizacaoContas }
  fetchedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, uf, cargo, partido])
  @@index([campaignId])
}
